// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          Int      @id @default(autoincrement())
  userId      String   @unique @db.Uuid @map("user_id")
  displayName String   @map("display_name")
  image       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

// table for trip
model Trip {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @db.Uuid // supabase user id
  title       String
  description String? 
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  inviteCode  String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members        TripMember[]
  itineraryItems ItineraryItem[]
  messages       Message[]
  expenses       Expense[]
  bookings Booking[]

  @@index([ownerId])
}

// who is joing what room table
model TripMember {
  id       String   @id @default(uuid()) @db.Uuid
  tripId   String   @db.Uuid
  userId   String   @db.Uuid
  role     TripRole @default(MEMBER)
  joinedAt DateTime @default(now())

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidExpenses  Expense[]      @relation("PaidExpenses")
  expenseSplits ExpenseSplit[]

  @@unique([tripId, userId])
  @@index([userId])
  @@index([tripId])
}

enum TripRole {
  OWNER
  MEMBER
}

enum ExpenseSplitType {
  EQUAL
  CUSTOM
}

model ItineraryItem {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @db.Uuid
  createdById String   @db.Uuid
  title       String
  detail      String?
  location    String?
  startTime   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, startTime])
  @@index([createdById])
}

model Message {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tripId String @db.Uuid
  content String
  clientMessageId String @db.Uuid 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tripId is related to Trip's id feild
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@unique([userId, clientMessageId])
  @@index([userId])
}

model Expense {
  id             String           @id @default(uuid()) @db.Uuid
  tripId         String           @map("trip_id") @db.Uuid
  paidByMemberId String           @map("paid_by_member_id") @db.Uuid
  title          String
  price          Decimal          @db.Decimal(12, 2)
  currency       String?
  splitType      ExpenseSplitType @default(EQUAL) @map("split_type")
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  trip         Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidByMember TripMember     @relation("PaidExpenses", fields: [paidByMemberId], references: [id])
  splits       ExpenseSplit[]

  @@index([tripId])
  @@index([paidByMemberId])
  @@map("expenses")
}

model ExpenseSplit {
  id           Int      @id @default(autoincrement())
  expenseId    String   @map("expense_id") @db.Uuid
  tripMemberId String   @map("trip_member_id") @db.Uuid
  owedAmount   Decimal  @map("owed_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  expense    Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tripMember TripMember @relation(fields: [tripMemberId], references: [id])

  @@unique([expenseId, tripMemberId])
  @@index([tripMemberId])
  @@map("expense_splits")
}

enum BookingType {
  FLIGHT
  HOTEL
  ACTIVITY
  TRANSPORT
  OTHER
}

model Booking {
  id String @id @default(uuid()) @db.Uuid
  tripId String @db.Uuid @map("trip_id")
  createdById String @map("created_by_id") @db.Uuid

  type BookingType
  title String 
  provider String? 
  confirmationCode String? @map("confirmation_code")
  startTime DateTime? @map("start_time")
  endTime DateTime? @map("end_time")
  note String? 
  details Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, startTime])
  @@index([createdById])
  @@map("bookings")
}